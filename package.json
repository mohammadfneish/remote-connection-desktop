{
  "name": "@rc/desktop",
  "productName": "Remote Connection",
  "version": "0.3.0",
  "private": true,
  "description": "Remote desktop client (host + viewer)",
  "author": {
    "name": "Mohammad Fneish",
    "email": "mohammadfneish@gmail.com"
  },
  "homepage": "https://github.com/mohammadfneish/remote-connection",
  "type": "module",
  "main": "src/main/main.js",
  "remoteConnection": {
    "defaultServerUrl": "wss://rdc.novatechsai.com"
  },
  "scripts": {
    "start": "electron .",
    "start:b": "electron . --profile=b",
    "dist": "electron-builder",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.remoteconnection.desktop",
    "productName": "Remote Connection",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "RemoteConnection-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "RemoteConnection-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Remote Connection shares your screen with the device you approve."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "artifactName": "RemoteConnection-${version}-${arch}.${ext}",
      "maintainer": "NovaTech <mohammadfneish@gmail.com>",
      "synopsis": "Remote desktop access"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Remote Connection",
      "runAfterFinish": true
    },
    "publish": null,
    "appx": {
      "applicationId": "RemoteConnection",
      "displayName": "Remote Connection",
      "publisherDisplayName": "NovaTech",
      "backgroundColor": "#0b4fd6",
      "showNameOnTiles": true,
      "languages": [
        "en-US"
      ],
      "setBuildNumber": true
    }
  }
}
